generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorldRole {
  ADMIN
  MEMBER
  VIEWER
}

enum CampaignStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  email       String  @unique
  username    String? @unique
  displayName String?

  ownedWorlds      World[]           @relation("WorldOwner")
  ownedCampaigns   Campaign[]        @relation("CampaignOwner")
  ownedCharacters  Character[]       @relation("CharacterOwner")
  worldMemberships WorldMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model World {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  ownerId String? @db.Uuid
  owner   User?   @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  memberships WorldMembership[]
  timelines   WorldTimeline[]
  campaigns   Campaign[]
  characters  WorldCharacter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Character {
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String  @db.Uuid
  name        String
  image       String?
  coreData    Json?
  status      String  @default("ACTIVE")

  owner           User             @relation("CharacterOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  worldCharacters WorldCharacter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

model WorldCharacter {
  id           String  @id @default(uuid()) @db.Uuid
  characterId  String  @db.Uuid
  worldId      String  @db.Uuid
  nameOverride String?
  worldData    Json?
  status       String  @default("ACTIVE")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId, worldId])
  @@index([worldId])
}

model WorldTimeline {
  id      String @id @default(uuid()) @db.Uuid
  worldId String @db.Uuid
  name    String

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
}

model WorldMembership {
  id String @id @default(uuid()) @db.Uuid

  worldId String    @db.Uuid
  userId  String    @db.Uuid
  role    WorldRole @default(MEMBER)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, userId])
  @@index([userId])
}

model Campaign {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  worldId String? @db.Uuid
  world   World?  @relation(fields: [worldId], references: [id], onDelete: Restrict)

  ownerId String @db.Uuid
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  timelineId String?        @db.Uuid
  timeline   WorldTimeline? @relation(fields: [timelineId], references: [id], onDelete: Restrict)

  currentWorldPosition  Decimal?       @db.Decimal(65, 30)
  currentWorldDateLabel String?
  status                CampaignStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([ownerId])
  @@index([timelineId])
  @@index([worldId, status])
}
