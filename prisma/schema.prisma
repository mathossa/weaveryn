generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorldRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  email       String  @unique
  username    String? @unique
  displayName String?

  ownedWorlds      World[]           @relation("WorldOwner")
  worldMemberships WorldMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model World {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  ownerId String? @db.Uuid
  owner   User?   @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  memberships WorldMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model WorldMembership {
  id String @id @default(uuid()) @db.Uuid

  worldId String    @db.Uuid
  userId  String    @db.Uuid
  role    WorldRole @default(MEMBER)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, userId])
  @@index([userId])
}
