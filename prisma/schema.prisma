generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorldRole {
  ADMIN
  MEMBER
  VIEWER
}

enum CampaignStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum CampaignRole {
  GM
  ASSISTANT_GM
  PLAYER
  SPECTATOR
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  email       String  @unique
  username    String? @unique
  displayName String?

  ownedWorlds         World[]              @relation("WorldOwner")
  ownedCampaigns      Campaign[]           @relation("CampaignOwner")
  worldMemberships    WorldMembership[]
  campaignMemberships CampaignMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model World {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  ownerId String? @db.Uuid
  owner   User?   @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  memberships WorldMembership[]
  timelines   WorldTimeline[]
  campaigns   Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model WorldTimeline {
  id      String @id @default(uuid()) @db.Uuid
  worldId String @db.Uuid
  name    String

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
}

model WorldMembership {
  id String @id @default(uuid()) @db.Uuid

  worldId String    @db.Uuid
  userId  String    @db.Uuid
  role    WorldRole @default(MEMBER)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, userId])
  @@index([userId])
}

model Campaign {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  worldId String? @db.Uuid
  world   World?  @relation(fields: [worldId], references: [id], onDelete: Restrict)

  ownerId String @db.Uuid
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  timelineId String?        @db.Uuid
  timeline   WorldTimeline? @relation(fields: [timelineId], references: [id], onDelete: Restrict)

  currentWorldPosition  Decimal?       @db.Decimal(65, 30)
  currentWorldDateLabel String?
  status                CampaignStatus @default(ACTIVE)

  memberships CampaignMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([ownerId])
  @@index([timelineId])
  @@index([worldId, status])
}

model CampaignMembership {
  id String @id @default(uuid()) @db.Uuid

  campaignId String       @db.Uuid
  userId     String       @db.Uuid
  role       CampaignRole

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([userId])
}
