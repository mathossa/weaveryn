generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorldRole {
  ADMIN
  MEMBER
  VIEWER
}

enum CampaignStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum CampaignRole {
  GM
  ASSISTANT_GM
  PLAYER
  SPECTATOR
}

enum CampaignCapability {
  UPDATE_CURRENT_LOCATION
}

enum VisibilityScope {
  WORLD
  CAMPAIGN
  GM
  PLAYER
  PRIVATE
}

enum EntryPreferenceKind {
  CHARACTER
  WEAVER
}

enum MembershipInvitationKind {
  WORLD
  CAMPAIGN
}

enum ReckoningDirection {
  BEFORE
  AFTER
}

model User {
  id              String  @id @default(uuid()) @db.Uuid
  email           String  @unique
  emailVerified   Boolean @default(false)
  username        String  @unique
  displayName     String?
  image           String?
  isInstanceAdmin Boolean @default(false)

  ownedWorlds                      World[]                @relation("WorldOwner")
  ownedCampaigns                   Campaign[]             @relation("CampaignOwner")
  ownedCharacters                  Character[]            @relation("CharacterOwner")
  worldMemberships                 WorldMembership[]
  campaignMemberships              CampaignMembership[]
  createdWorldEntities             WorldEntity[]          @relation("WorldEntityCreator")
  playerVisibleWorldEntities       WorldEntity[]          @relation("WorldEntityVisibilityUser")
  createdEntityRelationships       EntityRelationship[]   @relation("EntityRelationshipCreator")
  playerVisibleEntityRelationships EntityRelationship[]   @relation("EntityRelationshipVisibilityUser")
  createdWorldEntityTypes          WorldEntityType[]      @relation("WorldEntityTypeCreator")
  entryPreferences                 EntryPreference[]
  createdMembershipInvitations     MembershipInvitation[] @relation("MembershipInvitationCreator")
  acceptedMembershipInvitations    MembershipInvitation[] @relation("MembershipInvitationAcceptor")
  authSessions                     AuthSession[]
  authAccounts                     AuthAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model World {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  ownerId String? @db.Uuid
  owner   User?   @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  memberships           WorldMembership[]
  membershipInvitations MembershipInvitation[]
  timelines             WorldTimeline[]
  reckonings            WorldReckoning[]
  campaigns             Campaign[]
  characters            WorldCharacter[]
  entities              WorldEntity[]
  entityRelationships   EntityRelationship[]
  entityTypes           WorldEntityType[]
  entryPreferences      EntryPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model WorldEntity {
  id                    String  @id @default(uuid()) @db.Uuid
  worldId               String  @db.Uuid
  worldCharacterId      String? @db.Uuid
  worldCharacterWorldId String? @db.Uuid
  originCharacterId     String? @db.Uuid
  type                  String
  name                  String
  description           String?
  image                 String?
  imageFocusX           Int     @default(50)
  imageFocusY           Int     @default(50)
  data                  Json    @default("{}")

  createdById String? @db.Uuid

  visibilityScope      VisibilityScope @default(WORLD)
  visibilityCampaignId String?         @db.Uuid
  visibilityUserId     String?         @db.Uuid

  world              World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldCharacter     WorldCharacter? @relation("WorldCharacterEntity", fields: [worldCharacterId, worldCharacterWorldId], references: [id, worldId], onDelete: Cascade, onUpdate: Restrict)
  originCharacter    Character?      @relation("WorldEntityOriginCharacter", fields: [originCharacterId], references: [id], onDelete: SetNull)
  createdBy          User?           @relation("WorldEntityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  visibilityCampaign Campaign?       @relation("WorldEntityVisibilityCampaign", fields: [visibilityCampaignId], references: [id], onDelete: SetNull)
  visibilityUser     User?           @relation("WorldEntityVisibilityUser", fields: [visibilityUserId], references: [id], onDelete: SetNull)

  sourceRelationships EntityRelationship[] @relation("EntityRelationshipSource")
  targetRelationships EntityRelationship[] @relation("EntityRelationshipTarget")
  worldEventLinks     WorldEventEntity[]
  currentCampaigns    Campaign[]           @relation("CampaignCurrentLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldCharacterId, worldCharacterWorldId])
  @@index([worldId])
  @@index([worldCharacterWorldId])
  @@index([originCharacterId])
  @@index([worldId, originCharacterId])
  @@index([createdById])
  @@index([visibilityCampaignId])
  @@index([visibilityUserId])
  @@index([worldId, visibilityScope])
}

model EntityRelationship {
  id               String  @id @default(uuid()) @db.Uuid
  worldId          String  @db.Uuid
  sourceEntityId   String  @db.Uuid
  targetEntityId   String  @db.Uuid
  relationshipType String
  label            String?
  metadata         Json    @default("{}")

  createdById String? @db.Uuid

  visibilityScope      VisibilityScope @default(WORLD)
  visibilityCampaignId String?         @db.Uuid
  visibilityUserId     String?         @db.Uuid

  world              World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  sourceEntity       WorldEntity @relation("EntityRelationshipSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity       WorldEntity @relation("EntityRelationshipTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  createdBy          User?       @relation("EntityRelationshipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  visibilityCampaign Campaign?   @relation("EntityRelationshipVisibilityCampaign", fields: [visibilityCampaignId], references: [id], onDelete: SetNull)
  visibilityUser     User?       @relation("EntityRelationshipVisibilityUser", fields: [visibilityUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([createdById])
  @@index([visibilityCampaignId])
  @@index([visibilityUserId])
  @@index([worldId, visibilityScope])
}

model WorldEntityType {
  id             String  @id @default(uuid()) @db.Uuid
  worldId        String  @db.Uuid
  campaignId     String? @db.Uuid
  scopeKey       String
  name           String
  normalizedName String
  createdById    String? @db.Uuid

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("WorldEntityTypeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, scopeKey, normalizedName])
  @@index([worldId])
  @@index([campaignId])
  @@index([createdById])
}

model Character {
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String  @db.Uuid
  name        String
  image       String?
  coreData    Json?
  status      String  @default("ACTIVE")

  owner                   User             @relation("CharacterOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  worldCharacters         WorldCharacter[]
  worldEntityContinuities WorldEntity[]    @relation("WorldEntityOriginCharacter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

model WorldCharacter {
  id           String  @id @default(uuid()) @db.Uuid
  characterId  String  @db.Uuid
  worldId      String  @db.Uuid
  nameOverride String?
  worldData    Json?
  status       String  @default("ACTIVE")

  character          Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  world              World               @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldEntity        WorldEntity?        @relation("WorldCharacterEntity")
  campaignCharacters CampaignCharacter[]
  entryPreferences   EntryPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId, worldId])
  @@unique([id, worldId])
  @@index([worldId])
}

model WorldTimeline {
  id      String @id @default(uuid()) @db.Uuid
  worldId String @db.Uuid
  name    String

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  campaigns Campaign[]
  events    WorldEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
}

model WorldReckoning {
  id                   String  @id @default(uuid()) @db.Uuid
  worldId              String  @db.Uuid
  name                 String
  anchorWorldPosition  Decimal @db.Decimal(65, 30)
  anchorWorldDateLabel String
  beforeLabel          String
  beforeAbbreviation   String?
  afterLabel           String
  afterAbbreviation    String?

  world       World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  startEvents WorldEvent[] @relation("WorldEventStartReckoning")
  endEvents   WorldEvent[] @relation("WorldEventEndReckoning")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, name])
  @@index([worldId, anchorWorldPosition])
}

model WorldEvent {
  id                      String              @id @default(uuid()) @db.Uuid
  timelineId              String              @db.Uuid
  title                   String
  description             String?
  startWorldPosition      Decimal             @db.Decimal(65, 30)
  endWorldPosition        Decimal?            @db.Decimal(65, 30)
  startWorldDateLabel     String
  endWorldDateLabel       String?
  startReckoningId        String?             @db.Uuid
  startReckoningDirection ReckoningDirection?
  endReckoningId          String?             @db.Uuid
  endReckoningDirection   ReckoningDirection?
  type                    String              @default("event")
  data                    Json                @default("{}")

  timeline       WorldTimeline      @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  startReckoning WorldReckoning?    @relation("WorldEventStartReckoning", fields: [startReckoningId], references: [id], onDelete: Restrict)
  endReckoning   WorldReckoning?    @relation("WorldEventEndReckoning", fields: [endReckoningId], references: [id], onDelete: Restrict)
  entities       WorldEventEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timelineId, startWorldPosition])
  @@index([startReckoningId])
  @@index([endReckoningId])
}

model WorldEventEntity {
  worldEventId  String  @db.Uuid
  worldEntityId String  @db.Uuid
  role          String?

  worldEvent  WorldEvent  @relation(fields: [worldEventId], references: [id], onDelete: Cascade)
  worldEntity WorldEntity @relation(fields: [worldEntityId], references: [id], onDelete: Cascade)

  @@id([worldEventId, worldEntityId])
  @@index([worldEntityId])
}

model WorldMembership {
  id String @id @default(uuid()) @db.Uuid

  worldId String    @db.Uuid
  userId  String    @db.Uuid
  role    WorldRole @default(MEMBER)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, userId])
  @@index([userId])
}

model Campaign {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  worldId String? @db.Uuid
  world   World?  @relation(fields: [worldId], references: [id], onDelete: Restrict)

  ownerId String @db.Uuid
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  timelineId String?        @db.Uuid
  timeline   WorldTimeline? @relation(fields: [timelineId], references: [id], onDelete: Restrict)

  currentWorldPosition  Decimal?       @db.Decimal(65, 30)
  currentWorldDateLabel String?
  currentLocationId     String?        @db.Uuid
  currentLocation       WorldEntity?   @relation("CampaignCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  currentFocus          String?
  status                CampaignStatus @default(ACTIVE)

  memberships                CampaignMembership[]
  membershipInvitations      MembershipInvitation[]
  campaignCharacters         CampaignCharacter[]
  visibleWorldEntities       WorldEntity[]          @relation("WorldEntityVisibilityCampaign")
  visibleEntityRelationships EntityRelationship[]   @relation("EntityRelationshipVisibilityCampaign")
  worldEntityTypes           WorldEntityType[]
  entryPreferences           EntryPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([ownerId])
  @@index([timelineId])
  @@index([currentLocationId])
  @@index([worldId, status])
}

model CampaignMembership {
  id String @id @default(uuid()) @db.Uuid

  campaignId   String               @db.Uuid
  userId       String               @db.Uuid
  role         CampaignRole
  capabilities CampaignCapability[] @default([])

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([userId])
}

model MembershipInvitation {
  id           String                   @id @default(uuid()) @db.Uuid
  kind         MembershipInvitationKind
  tokenHash    String                   @unique
  worldId      String?                  @db.Uuid
  campaignId   String?                  @db.Uuid
  worldRole    WorldRole?
  campaignRole CampaignRole?
  createdById  String                   @db.Uuid
  acceptedById String?                  @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  world      World?    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("MembershipInvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("MembershipInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId, expiresAt])
  @@index([campaignId, expiresAt])
  @@index([createdById])
  @@index([acceptedById])
  @@index([expiresAt])
}

model CampaignCharacter {
  id String @id @default(uuid()) @db.Uuid

  worldCharacterId String @db.Uuid
  campaignId       String @db.Uuid
  sheetData        Json   @default("{}")
  status           String @default("ACTIVE")

  worldCharacter WorldCharacter @relation(fields: [worldCharacterId], references: [id], onDelete: Cascade)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldCharacterId, campaignId])
  @@index([campaignId])
}

model EntryPreference {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  entryKey         String
  kind             EntryPreferenceKind
  worldCharacterId String?             @db.Uuid
  campaignId       String?             @db.Uuid
  worldId          String?             @db.Uuid
  pinned           Boolean             @default(false)
  lastUsedAt       DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldCharacter WorldCharacter? @relation(fields: [worldCharacterId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  world          World?          @relation(fields: [worldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entryKey])
  @@index([userId, pinned, lastUsedAt])
  @@index([worldCharacterId])
  @@index([campaignId])
  @@index([worldId])
}
