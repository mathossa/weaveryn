# Local application and visual acceptance scenarios use a dedicated database.
DATABASE_URL=postgresql://weaveryn:weaveryn_dev@localhost:5432/weaveryn_dev
DEV_DATABASE_NAME=weaveryn_dev

# Better Auth (generate a unique 32+ character secret for each deployment)
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated additional origins, for example a local reverse proxy.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Instance administration
# Admin routes fail closed when this allowlist is empty. Configure the addresses
# or CIDR ranges that may reach /admin, for example 192.168.10.0/24,10.20.0.5/32.
ADMIN_ALLOWED_CIDRS=

# Next.js does not expose the direct peer IP. Only enable proxy headers when your
# reverse proxy strips client-supplied copies and sets this header itself.
ADMIN_TRUST_PROXY_HEADERS=false
ADMIN_CLIENT_IP_HEADER=x-forwarded-for

# Optional emergency CLI password override. Prefer setting it only for the
# single command invocation; if unset, the CLI generates a temporary password.
# WEAVERYN_ADMIN_RESET_PASSWORD=
